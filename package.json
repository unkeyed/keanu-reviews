{
  "name": "keanu-reviews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-way GitHub -> Slack PR bot: one channel per PR, axolo.co-style.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "admin:import-identities": "node --experimental-strip-types src/admin/importIdentities.ts",
    "jobs:replay": "node --experimental-strip-types src/admin/replayJob.ts",
    "jobs:reconcile-closed-prs": "node --experimental-strip-types src/admin/reconcileClosedPullRequests.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@octokit/auth-app": "^8.3.0",
    "@slack/web-api": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11",
      "hono@<4.13.5": ">=4.13.5",
      "hono@<4.13.7": ">=4.13.7",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "tinypool@<=2.1.0": ">=2.1.1",
      "tinypool@<2.1.2": ">=2.1.2",
      "hono@>=4.12.4 <4.13.11": ">=4.13.11",
      "vite@>=7.0.0 <=7.3.6": ">=7.3.7",
      "@vitest/mocker@>=2.1.0-beta.7 <4.1.12": ">=4.1.12",
      "zod@<4.6.6": ">=4.6.6",
      "@hono/node-server@>=1.19.10 <2.1.3": ">=2.1.3"
    }
  }
}
