# Keanu Reviews — environment configuration.
# On a managed host these are provided by the platform secret store (KTD12).
# Copy to .env for local development. NEVER commit a real .env.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# GitHub App (U3) — secrets, do not log
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub App OAuth settings used to prove `/link-github` account ownership
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Independent random value of at least 32 characters for signing short-lived OAuth state
OAUTH_STATE_SECRET=
# Public HTTPS origin only (HTTP is accepted on loopback for local development).
# Register the callback `${PUBLIC_URL}/oauth/github/callback`.
PUBLIC_URL=
# Single numeric installation id allowed to reach this first-release service (U3)
GITHUB_INSTALLATION_ID=
# Opt-in GitHub WRITE: post the Slack channel URL as a comment when a PR merges.
# The only write path. "true" requires granting the App write permission
# (Pull requests / Issues) and reinstalling. Default false = fully one-way.
GITHUB_COMMENT_ON_MERGE=false

# Slack app (U4-U9) — secrets, do not log
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Single Slack workspace allowed to invoke the slash command
SLACK_TEAM_ID=
# Optional: channel that gets a "shipped" announcement when a PR is merged.
# Channel ID (e.g. C0123ABCD) or name (e.g. shipped). Leave blank to disable.
SLACK_SHIPPED_CHANNEL=

# Optional: comma-separated bot logins whose comments/reviews SHOULD be mirrored
# (all other bots stay filtered as deploy-preview noise). Case and the GitHub
# "[bot]" suffix are ignored, so "pullfrog" matches "pullfrog[bot]". Never list
# this App's own bot login here, or it would echo its own merge comments.
ALLOWED_BOTS=

# Optional: quiet archiving. Set ALL THREE (or none) to let `/link-slack` collect
# a per-user Slack token so participants leave PR channels before archive,
# suppressing Slack's "archived the channel" notification. Register the callback
# `${PUBLIC_URL}/oauth/slack/callback` and add the `channels:write` USER scope.
# SLACK_USER_TOKEN_ENC_KEY: 32 bytes, hex/base64 (e.g. `openssl rand -hex 32`).
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_USER_TOKEN_ENC_KEY=

# Storage (U2) — PlanetScale Postgres connection URL (secret)
DATABASE_URL=

# Reminder scheduler (U8)
REMINDER_HOURS=12
REMINDER_SCAN_INTERVAL_MS=60000
# Reminders are only delivered during this daily window (start inclusive, end
# exclusive), evaluated in REMINDER_WINDOW_TZ. Default 05:00–14:00 Eastern.
# A reminder that comes due outside the window waits until it next opens.
REMINDER_WINDOW_START_HOUR=5
REMINDER_WINDOW_END_HOUR=14
REMINDER_WINDOW_TZ=America/New_York
