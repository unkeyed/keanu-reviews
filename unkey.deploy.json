{
  "name": "unkey-slack-pr-bot",
  "runtime": "node",
  "entrypoint": "src/index.ts",
  "healthCheck": {
    "path": "/health",
    "port": 3000
  },
  "instances": {
    "min": 1,
    "max": 1,
    "note": "Single instance matches the first-release deployment; database leases protect rolling overlap."
  },
  "secrets": [
    "GITHUB_APP_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_WEBHOOK_SECRET",
    "GITHUB_OAUTH_CLIENT_ID",
    "GITHUB_OAUTH_CLIENT_SECRET",
    "OAUTH_STATE_SECRET",
    "PUBLIC_URL",
    "GITHUB_INSTALLATION_ID",
    "SLACK_BOT_TOKEN",
    "SLACK_SIGNING_SECRET",
    "SLACK_TEAM_ID",
    "DATABASE_URL"
  ]
}
